{
    "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",

    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },

    "files": {
        "includes": ["**", "!coverage", "!**/node_modules", "!**/node_modules", "!**/.old", "!**/.old"]
    },

    "formatter": {
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 180
    },

    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "trailingCommas": "none"
        }
    },

    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended",
            "suspicious": {
                "noExplicitAny": "off"
            }
        }
    },

    "assist": {
        "actions": {
            "source": {
                "organizeImports": "off"
            }
        }
    }
}
